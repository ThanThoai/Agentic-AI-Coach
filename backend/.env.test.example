# ── Test environment ───────────────────────────────────────────────────────────
# Copy to .env.test and fill in real keys only for `live` tests.
# Mock tests (default) work with NO real keys — all network calls are intercepted.

APP_ENV=test
LOG_LEVEL=WARNING

# ── Database (use a separate test DB) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coach_agent_test
REDIS_URL=redis://localhost:6379/1

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=test-secret-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Qdrant (in-memory mode for tests) ─────────────────────────────────────────
QDRANT_URL=:memory:             # qdrant-client supports in-memory mode
QDRANT_API_KEY=
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base_test
QDRANT_COLLECTION_WORKOUTS=workout_embeddings_test

# ── LLM Providers — LIVE TEST KEYS ────────────────────────────────────────────
# Leave blank to skip that provider's live test suite.
# Live tests only run when pytest is invoked with: uv run pytest -m live

DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_EMBEDDING_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001   # cheapest model for live tests

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

GROK_API_KEY=
GROK_DEFAULT_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=CoachAgent
