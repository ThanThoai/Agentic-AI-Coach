# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | test | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                         # leave empty for local dev
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base
QDRANT_COLLECTION_WORKOUTS=workout_embeddings

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Set the provider to use as default: anthropic | openai | gemini | grok | openrouter
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_EMBEDDING_PROVIDER=openai

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# Grok (xAI) — OpenAI-compatible endpoint
GROK_API_KEY=xai-...
GROK_DEFAULT_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# OpenRouter — routes to multiple providers
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000   # sent as HTTP-Referer
OPENROUTER_SITE_NAME=CoachAgent

# ── RAG pipeline — per-step model routing ──────────────────────────────────────
# Leave blank to fall back to DEFAULT_LLM_PROVIDER + its default model.
# Set PROVIDER to override which provider handles that step.
# Set MODEL to pin a specific model name for that step.
#
# Recommended: use a fast/cheap model for classifiers, stronger for generation.
#
# Example (Anthropic-only, tiered):
#   RAG_GUARDRAIL_MODEL=claude-haiku-4-5-20251001
#   RAG_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
#   RAG_REWRITE_MODEL=claude-haiku-4-5-20251001
#   RAG_CONFLICT_MODEL=claude-haiku-4-5-20251001
#   RAG_GENERATION_MODEL=claude-sonnet-4-6
#
# Example (mixed providers):
#   RAG_GUARDRAIL_PROVIDER=openai
#   RAG_GUARDRAIL_MODEL=gpt-4o-mini
#   RAG_GENERATION_PROVIDER=anthropic
#   RAG_GENERATION_MODEL=claude-opus-4-7

# Step 1 — L2 intent classifier (runs only on risk-signal queries)
RAG_GUARDRAIL_PROVIDER=
RAG_GUARDRAIL_MODEL=

# Step 2 — query type classifier (SIMPLE / COMPLEX / COMPARISON)
RAG_CLASSIFIER_PROVIDER=
RAG_CLASSIFIER_MODEL=

# Step 3 — query rewriter + decomposer
RAG_REWRITE_PROVIDER=
RAG_REWRITE_MODEL=

# Step 4 — conflict detection LLM re-check (optional, runs on heuristic candidates)
RAG_CONFLICT_PROVIDER=
RAG_CONFLICT_MODEL=

# Step 5 — final answer generation (most quality-sensitive)
RAG_GENERATION_PROVIDER=
RAG_GENERATION_MODEL=
