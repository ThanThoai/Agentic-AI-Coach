# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# Public URL of the application (used by nginx + frontend build in production)
# Example: https://yourdomain.com  or  http://localhost (local prod test)
PUBLIC_URL=http://localhost

# Gunicorn worker count (production only). Suggested: 2 × CPU_CORES + 1
GUNICORN_WORKERS=4

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-min-32-chars

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                         # leave empty for local dev
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Provider for LLM calls: anthropic | openai | gemini | grok | openrouter
# Provider for embeddings: openai  (OpenRouter does not support embeddings API)
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_EMBEDDING_PROVIDER=openai

# OpenRouter — single key, access to 100+ models
# All RAG pipeline steps route through OpenRouter when DEFAULT_LLM_PROVIDER=openrouter.
# Per-step model defaults (haiku for light steps, sonnet for generation) are applied
# automatically — override with RAG_*_MODEL below if needed.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=CoachAgent

# OpenAI — required for embeddings (even when using OpenRouter for LLM)
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Other providers (optional, set only if switching away from OpenRouter) ──────

# Anthropic (direct)
# DEFAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# OpenAI (direct)
# DEFAULT_LLM_PROVIDER=openai
# OPENAI_DEFAULT_MODEL=gpt-4o

# Google Gemini
# DEFAULT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Grok (xAI)
# DEFAULT_LLM_PROVIDER=grok
# GROK_API_KEY=xai-...
# GROK_DEFAULT_MODEL=grok-3-mini-beta

# ── RAG pipeline — per-step model routing ──────────────────────────────────────
# When DEFAULT_LLM_PROVIDER=openrouter, each step automatically uses the
# openrouter_*_model defaults (haiku for fast steps, sonnet for generation).
#
# Override here only if you want a specific model for a step.
# Leave blank to use the automatic defaults.
#
# OpenRouter model format: "<provider>/<model-name>"
#   Fast / cheap : anthropic/claude-haiku-4-5
#                  openai/gpt-4o-mini
#                  google/gemini-2.0-flash-exp
#   Capable      : anthropic/claude-sonnet-4-5
#                  openai/gpt-4o
#                  google/gemini-2.5-pro

# Step 1 — L2 intent classifier (fast, runs only on risk-signal queries)
RAG_GUARDRAIL_MODEL=

# Step 2 — query type classifier (SIMPLE / COMPLEX / COMPARISON)
RAG_CLASSIFIER_MODEL=

# Step 3 — query rewriter + decomposer
RAG_REWRITE_MODEL=

# Step 4 — conflict detection LLM re-check (fast, runs on heuristic candidates)
RAG_CONFLICT_MODEL=

# Step 5 — final answer generation (quality-sensitive, uses stronger model by default)
RAG_GENERATION_MODEL=

# ── Workout analysis — per-step model routing ─────────────────────────────────
WORKOUT_CLASSIFIER_MODEL=
WORKOUT_GENERATION_MODEL=

# ── Agent orchestration ────────────────────────────────────────────────────────
AGENT_PROVIDER=              # defaults to DEFAULT_LLM_PROVIDER
AGENT_MODEL=                 # defaults to provider default model

# ── Database (Docker Compose reads POSTGRES_* to create the container) ─────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coach_agent

# DATABASE_URL is injected by docker-compose using the POSTGRES_* vars above.
# Set it explicitly only when running the backend outside Docker:
#   postgresql+asyncpg://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:5432/$POSTGRES_DB
