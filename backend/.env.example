# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | test | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coach_agent
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                         # leave empty for local dev
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base
QDRANT_COLLECTION_WORKOUTS=workout_embeddings

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Set the provider to use as default: anthropic | openai | gemini | grok | openrouter
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_EMBEDDING_PROVIDER=openai

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_DEFAULT_MODEL=gemini-1.5-pro

# Grok (xAI) — OpenAI-compatible endpoint
GROK_API_KEY=xai-...
GROK_DEFAULT_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# OpenRouter — routes to multiple providers
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000   # sent as HTTP-Referer
OPENROUTER_SITE_NAME=CoachAgent
